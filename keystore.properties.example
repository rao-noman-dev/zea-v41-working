# EXAMPLE ONLY — copy this file to `keystore.properties` (which is git-ignored)
# and fill in REAL values locally. Never commit real credentials.
#
# The Gradle build registers the `externalRelease` signing config only when
# ALL FOUR fields below are present. Otherwise the release APK stays unsigned
# and debug builds use the standard debug keystore.

storeFile=/absolute/path/to/your-production.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
