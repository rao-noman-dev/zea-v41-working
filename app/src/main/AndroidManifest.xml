<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Contacts are read only after the user grants runtime permission. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Device Owner stack (restored by explicit owner decision):
        usage stats feed the DO private-session monitor; the foreground-service
        pair backs the special-use monitor service that only runs while the
        app holds the Device Owner role.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
        After a hide/unhide toggle some OEM launchers (vivo FunTouch) keep a stale
        ghost row with a dummy icon until their process restarts. Killing the cached
        home launcher forces it to rebuild its app model on next start.
    -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!--
        Package visibility is limited to Zea's launcher use cases.
        QUERY_ALL_PACKAGES and ACCESS_HIDDEN_PROFILES are intentionally excluded.
        Static package declarations support approved apps on Android versions where
        package queries are filtered. Dynamic apps are discovered through launcher
        intent visibility and are stored only after local verification.
    -->
